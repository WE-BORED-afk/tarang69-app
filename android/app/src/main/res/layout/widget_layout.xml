<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="@drawable/widget_background">

    <!-- Top Status Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/widget_status_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🟢 กำลังเรียน"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="#A7F3D0" />

        <TextView
            android:id="@+id/widget_day_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="end"
            android:text="ม.6/9"
            android:textSize="12sp"
            android:textColor="#E0E7FF"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Subject Name -->
    <TextView
        android:id="@+id/widget_subject_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="วิชาที่กำลังเรียน"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="#FFFFFF"
        android:maxLines="1"
        android:ellipsize="end" />

    <!-- Room and Time -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/widget_subject_room"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="#33FFFFFF"
            android:paddingHorizontal="8dp"
            android:paddingVertical="2dp"
            android:text="📍 ห้องเรียน"
            android:textSize="11sp"
            android:textColor="#FFFFFF"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_subject_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="08.20 - 09.10 น."
            android:textSize="11sp"
            android:textColor="#C7D2FE" />
    </LinearLayout>

    <!-- Next Subject Footer -->
    <TextView
        android:id="@+id/widget_next_subject"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="คาบถัดไป: ..."
        android:textSize="11sp"
        android:textColor="#E0E7FF"
        android:maxLines="1"
        android:ellipsize="end" />

</LinearLayout>
